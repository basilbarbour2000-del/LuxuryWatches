<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SignupFragment">

    <!-- TODO: Update blank fragment layout -->

    <EditText
        android:id="@+id/etUsernameSignup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:ems="10"
        android:hint="username...."
        android:inputType="textEmailAddress"
        app:layout_constraintStart_toStartOf="@+id/etLastnameSignupFragment"
        app:layout_constraintTop_toBottomOf="@+id/etLastnameSignupFragment"
        tools:ignore="DuplicateClickableBoundsCheck" />

    <EditText
        android:id="@+id/etPasswordSignup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:ems="10"
        android:hint="password...."
        android:inputType="textPassword"
        app:layout_constraintStart_toStartOf="@+id/etUsernameSignup"
        app:layout_constraintTop_toBottomOf="@+id/etUsernameSignup" />

    <Button
        android:id="@+id/btnSignupSignup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="82dp"
        android:layout_marginBottom="60dp"
        android:backgroundTint="#6F7F8F"
        android:text="SIGNUP"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivPhotoSignupFragment" />

    <ImageView
        android:id="@+id/ivPhotoSignupFragment"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_marginStart="92dp"
        android:layout_marginEnd="38dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/ic_add"
        android:src="@drawable/top_backgroun_profile"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnSignupSignup"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/H1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginTop="16dp"
        android:text="LuxuryWatches"
        android:textSize="50sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/etFirstnameSignupFragment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:ems="10"
        android:hint="firstname..."
        android:inputType="text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/H1" />

    <EditText
        android:id="@+id/etLastnameSignupFragment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:ems="10"
        android:hint="lastname..."
        android:inputType="text"
        app:layout_constraintStart_toStartOf="@+id/etFirstnameSignupFragment"
        app:layout_constraintTop_toBottomOf="@+id/etFirstnameSignupFragment" />

    <EditText
        android:id="@+id/etConfirmPasswordSignupFragment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="21dp"
        android:ems="10"
        android:hint="confirm password..."
        android:inputType="textPassword"
        app:layout_constraintStart_toStartOf="@+id/etPasswordSignup"
        app:layout_constraintTop_toBottomOf="@+id/etPasswordSignup" />

    <EditText
        android:id="@+id/etPhoneSignupFragment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:ems="10"
        android:hint="phone..."
        android:inputType="number|numberDecimal|numberSigned"
        app:layout_constraintStart_toStartOf="@+id/etConfirmPasswordSignupFragment"
        app:layout_constraintTop_toBottomOf="@+id/etConfirmPasswordSignupFragment" />

    <EditText
        android:id="@+id/etAddressSignupFragment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:ems="10"
        android:hint="address..."
        android:inputType="text"
        app:layout_constraintStart_toStartOf="@+id/etPhoneSignupFragment"
        app:layout_constraintTop_toBottomOf="@+id/etPhoneSignupFragment"
        app:layout_constraintBottom_toTopOf="@+id/ivPhotoSignupFragment" />

</androidx.constraintlayout.widget.ConstraintLayout>

